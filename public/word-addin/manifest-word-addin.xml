<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>d3b07384-d113-4b3a-a726-21b8c2d2748f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>PlataformaDoc</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="PlataformaDoc Legal" />
  <Description DefaultValue="Complemento para gestión documental y control de versiones." />
  <IconUrl DefaultValue="https://localhost/PlataformaDoc/public/word-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost/PlataformaDoc/public/word-addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost/PlataformaDoc" />

  <AppDomains>
    <AppDomain>https://localhost</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost/PlataformaDoc/public/word-addin/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMore"/>
          </GetStarted>
          <FunctionFile resid="TaskpaneUrl" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="TabPlataformaDoc">
              <Group id="GroupPlataformaDoc">
                <Label id="GroupLabel" DefaultValue="Gestión Documental" />
                <Control xsi:type="Button" id="BtnAbrirPanel">
                  <Label id="BtnLabel" DefaultValue="Abrir Panel" />
                  <Supertip>
                    <Title id="SuperTitle" DefaultValue="PlataformaDoc" />
                    <Description id="SuperDesc" DefaultValue="Abre el panel para sincronizar versiones." />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
              <Label id="TabLabel" DefaultValue="Plataforma Legal" />
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://localhost/PlataformaDoc/public/word-addin/assets/icon-16.png" />
        <bt:Image id="Icon32" DefaultValue="https://localhost/PlataformaDoc/public/word-addin/assets/icon-32.png" />
        <bt:Image id="Icon80" DefaultValue="https://localhost/PlataformaDoc/public/word-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://localhost/PlataformaDoc/public/word-addin/index.html" />
        <bt:Url id="GetStarted.LearnMore" DefaultValue="https://localhost/PlataformaDoc" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Bienvenido a PlataformaDoc" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Gestione sus documentos y versiones directamente desde Word." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>