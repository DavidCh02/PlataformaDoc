<?xml version="1.0" encoding="UTF-8"?>
<!-- PlataformaDoc · Manifest de PRODUCCION (Railway).
     El manifest local (manifest-word-addin.xml) queda intacto.
     Id distinto al local para que ambos puedan convivir en el mismo Word.
     Sideload en Word: Insertar > Complementos > Mis complementos >
     Cargar complemento no publicado > elegir este archivo. -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>ef6ffa69-f87b-4e9a-b0dc-2f38ba93992a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>PlataformaDoc</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="PlataformaDoc Legal (Prod)" />
  <Description DefaultValue="Complemento para gestión documental y control de versiones." />
  <IconUrl DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://plataformadoc-production-ec46.up.railway.app" />

  <AppDomains>
    <AppDomain>https://plataformadoc-production-ec46.up.railway.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMore"/>
          </GetStarted>
          <FunctionFile resid="TaskpaneUrl" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="TabPlataformaDoc">
              <Group id="GroupPlataformaDoc">
                <Label id="GroupLabel" DefaultValue="Gestión Documental" />
                <Control xsi:type="Button" id="BtnAbrirPanel">
                  <Label id="BtnLabel" DefaultValue="Abrir Panel" />
                  <Supertip>
                    <Title id="SuperTitle" DefaultValue="PlataformaDoc" />
                    <Description id="SuperDesc" DefaultValue="Abre el panel para sincronizar versiones." />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
              <Label id="TabLabel" DefaultValue="Plataforma Legal" />
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/assets/icon-16.png" />
        <bt:Image id="Icon32" DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/assets/icon-32.png" />
        <bt:Image id="Icon80" DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://plataformadoc-production-ec46.up.railway.app/word-addin/index.html" />
        <bt:Url id="GetStarted.LearnMore" DefaultValue="https://plataformadoc-production-ec46.up.railway.app" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Bienvenido a PlataformaDoc" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Gestione sus documentos y versiones directamente desde Word." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
