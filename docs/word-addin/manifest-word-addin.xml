  <AppDomains>
    <AppDomain>PON-AQUI-TU-DOMINIO</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://PON-AQUI-TU-DOMINIO/word-addin/index.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
